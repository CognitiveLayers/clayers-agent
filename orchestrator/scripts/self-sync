#!/usr/bin/env bash
set -euo pipefail

orchestrator_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
base_url="${CLAYERS_ORCHESTRATOR_URL:-http://127.0.0.1:8787}"
base_url="${base_url%/}"
started_server=0
server_pid=""

need() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  }
}

cleanup() {
  if [ "$started_server" -eq 1 ] && [ -n "$server_pid" ]; then
    kill "$server_pid" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

need curl
need node

cd "$orchestrator_root"
if [ ! -x node_modules/.bin/tsc ]; then
  npm_config_cache="${npm_config_cache:-/tmp/clayers-npm-cache}" npm ci >/dev/null
fi
npm run build >/dev/null

if ! curl -fsS "$base_url/health" >/dev/null 2>&1; then
  port="$((38000 + RANDOM % 20000))"
  base_url="http://127.0.0.1:$port"
  workdir="$(mktemp -d /tmp/clayers-orchestrator-self.XXXXXX)"
  server_log="$workdir/server.log"
  CLAYERS_ORCHESTRATOR_WORKDIR="$workdir/jobs" \
    CLAYERS_ORCHESTRATOR_ALLOW_LOCAL_PATHS=1 \
    node "$orchestrator_root/dist/server.js" --host 127.0.0.1 --port "$port" >"$server_log" 2>&1 &
  server_pid="$!"
  started_server=1

  for _ in $(seq 1 80); do
    if curl -fsS "$base_url/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done

  if ! curl -fsS "$base_url/health" >/dev/null; then
    printf 'orchestrator did not become healthy\n' >&2
    sed -n '1,160p' "$server_log" >&2
    exit 1
  fi
fi

node "$orchestrator_root/dist/client.js" submit \
  --host "$base_url" \
  --path "$orchestrator_root" \
  --mode sync \
  --stream
